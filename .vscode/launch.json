{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Debug Chrome Extension",
            "url": "https://www.baidu.com",
            "webRoot": "${workspaceFolder}",
            "sourceMaps": true,
            "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile",
            "runtimeArgs": [
                "--load-extension=${workspaceFolder}\\extension",
                // "--disable-extensions-except=${workspaceFolder}\\extension"
            ],
            "sourceMapPathOverrides": {
                "webpack://empty-project/*": "${webRoot}/*"
            }
        }
    ]
}