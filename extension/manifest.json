{
  "manifest_version": 3,
  "name": "Fullscreen Time",
  "description": "在视频全屏或浏览器全屏时显示系统时间浮层，支持快捷键自定义",
  "version": "1.0",
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "action": {
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    },
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "js": ["./content.js"],
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "run_at": "document_end"
    }
  ]
}
